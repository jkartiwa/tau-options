# Tastytrade OAuth2 personal grant, read scope only.
# Same credentials as axion's backend/.env — setup steps documented there
# (my.tastytrade.com → Manage → API → OAuth applications → personal grant).
TASTY_CLIENT_SECRET=
TASTY_REFRESH_TOKEN=

# Optional overrides
# TAU_DATA_DIR=~/.local/share/tau   # scan-log SQLite location
# TAU_UNIVERSE=/path/to/universe.txt
