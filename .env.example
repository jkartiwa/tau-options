# Tastytrade OAuth2 personal grant. Trading scope is required: the buying
# power figure comes from the order dry-run *calculation*, which is a
# trading-scope call. tau only ever calls that dry-run — nothing here
# places, modifies, or cancels an order.
TASTY_CLIENT_SECRET=
TASTY_REFRESH_TOKEN=

# Optional overrides
# TAU_DATA_DIR=~/.local/share/tau   # scan-log SQLite location
# TAU_UNIVERSE=/path/to/universe.txt
