# tastytrade OAuth2 personal grant. Trade scope is required because the
# buying-power figure comes from the order dry-run calculation; tau never
# places, modifies, or cancels an order.
TASTY_CLIENT_SECRET=
TASTY_REFRESH_TOKEN=

# Optional: enables the catalyst classification (headlines show without it).
# ANTHROPIC_API_KEY=

# Optional overrides
# TAU_DATA_DIR=~/.local/share/tau   # scan-log SQLite location
# TAU_UNIVERSE=/path/to/universe.txt
